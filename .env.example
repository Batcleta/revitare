# Gemini Developer API key (server only)
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.1-flash-image
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional private-beta gate. Leave empty for local/open testing.
REVITARE_ACCESS_KEY=

# Added automatically when a Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=
